{
  "additionalProperties": false,
  "properties": {
    "account": {
      "enum": [
        "google",
        "x",
        "microsoft"
      ],
      "title": "Account",
      "type": "string"
    },
    "address": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Address"
    },
    "configured": {
      "title": "Configured",
      "type": "boolean"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sign_in": {
      "enum": [
        "this_computer",
        "link",
        "device",
        "unavailable"
      ],
      "title": "Sign In",
      "type": "string"
    },
    "sign_in_blocker": {
      "anyOf": [
        {
          "enum": [
            "public_address_required",
            "desktop_client",
            "redirect_not_listed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sign In Blocker"
    },
    "state": {
      "enum": [
        "not_configured",
        "not_authenticated",
        "saved_unchecked",
        "partial",
        "connected",
        "invalid",
        "expired",
        "unavailable"
      ],
      "title": "State",
      "type": "string"
    },
    "token_files": {
      "maximum": 17,
      "minimum": 0,
      "title": "Token Files",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "account",
    "revision",
    "configured",
    "state",
    "token_files",
    "sign_in"
  ],
  "title": "AccountAuthSnapshot",
  "type": "object"
}
