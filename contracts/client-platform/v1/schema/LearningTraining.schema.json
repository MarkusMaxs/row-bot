{
  "$defs": {
    "LearningRemoteRun": {
      "additionalProperties": false,
      "description": "A Hugging Face run's own facts (C1): its stage, cost so far, lost contact, cleanup. Never a token.",
      "properties": {
        "cleaned": {
          "title": "Cleaned",
          "type": "boolean"
        },
        "cleanup_failed": {
          "title": "Cleanup Failed",
          "type": "boolean"
        },
        "cost_usd": {
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "flavor": {
          "maxLength": 32,
          "title": "Flavor",
          "type": "string"
        },
        "lost": {
          "title": "Lost",
          "type": "boolean"
        },
        "minutes": {
          "minimum": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "phase": {
          "enum": [
            "uploading",
            "submitting",
            "running",
            "downloading",
            "downloaded",
            "cleaned"
          ],
          "title": "Phase",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "setting_up",
                "downloading",
                "training",
                "exporting",
                "uploading",
                "done"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "phase",
        "cost_usd",
        "minutes",
        "lost",
        "flavor",
        "cleaned",
        "cleanup_failed"
      ],
      "title": "LearningRemoteRun",
      "type": "object"
    },
    "LearningRunnerStatus": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "enum": [
                "train_off",
                "hugging_face",
                "no_engine",
                "no_data",
                "quiet_hours",
                "after_dream",
                "now",
                "in_use",
                "chat",
                "workflow",
                "indexing",
                "dream",
                "you",
                "app_closed",
                "worker_stopped",
                "out_of_gpu_memory",
                "out_of_disk",
                "cannot_resume",
                "data_unreadable",
                "engine_error",
                "learning_off",
                "learning_paused",
                "extraction",
                "planned",
                "planning",
                "up_to_date",
                "gpu_busy",
                "memory_busy",
                "comparing",
                "hf_signed_out",
                "hf_no_model",
                "hf_unknown",
                "hf_first_run",
                "hf_over_cap",
                "hf_no_credit",
                "hf_network",
                "hf_busy",
                "hf_not_confirmed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "off",
            "paused",
            "training",
            "waiting",
            "scheduled",
            "held",
            "failed",
            "trained",
            "nothing_to_do"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "LearningRunnerStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The personal model's current training run (L2a), polled while it runs.",
  "properties": {
    "can_train_now": {
      "title": "Can Train Now",
      "type": "boolean"
    },
    "checkpoint_step": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Step"
    },
    "failure": {
      "anyOf": [
        {
          "enum": [
            "out_of_gpu_memory",
            "out_of_disk",
            "cannot_resume",
            "data_unreadable",
            "engine_error",
            "upload_failed",
            "not_started",
            "remote_error",
            "no_credit",
            "signed_out",
            "model_mismatch",
            "export_failed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure"
    },
    "job_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "pause_reason": {
      "anyOf": [
        {
          "enum": [
            "in_use",
            "local_gpu",
            "learning_paused",
            "learning_off",
            "you",
            "app_closed",
            "worker_stopped"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pause Reason"
    },
    "recovered": {
      "anyOf": [
        {
          "enum": [
            "previous_checkpoint",
            "start_over"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recovered"
    },
    "remote": {
      "anyOf": [
        {
          "$ref": "#/$defs/LearningRemoteRun"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resumes": {
      "anyOf": [
        {
          "enum": [
            "quiet_hours",
            "when_free",
            "ask"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resumes"
    },
    "runner": {
      "$ref": "#/$defs/LearningRunnerStatus"
    },
    "seconds_left": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seconds Left"
    },
    "state": {
      "enum": [
        "none",
        "planned",
        "waiting",
        "preparing",
        "running",
        "pausing",
        "paused",
        "evaluating",
        "failed",
        "unknown_remote"
      ],
      "title": "State",
      "type": "string"
    },
    "step": {
      "minimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "steps_total": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Steps Total"
    },
    "trigger": {
      "anyOf": [
        {
          "enum": [
            "quiet_hours",
            "train_now"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trigger"
    },
    "version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    },
    "where": {
      "default": "this_computer",
      "enum": [
        "this_computer",
        "hugging_face"
      ],
      "title": "Where",
      "type": "string"
    }
  },
  "required": [
    "state",
    "step",
    "can_train_now",
    "runner"
  ],
  "title": "LearningTraining",
  "type": "object"
}
