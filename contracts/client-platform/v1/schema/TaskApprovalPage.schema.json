{
  "$defs": {
    "TaskApprovalCard": {
      "additionalProperties": false,
      "description": "Exactly what a person-only (\"Always ask me\") approval lets happen.",
      "properties": {
        "account": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account"
        },
        "action": {
          "maxLength": 1024,
          "title": "Action",
          "type": "string"
        },
        "destination": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination"
        },
        "media": {
          "items": {
            "$ref": "#/$defs/TaskApprovalMedia"
          },
          "maxItems": 16,
          "title": "Media",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "action"
      ],
      "title": "TaskApprovalCard",
      "type": "object"
    },
    "TaskApprovalMedia": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "pattern": "^[0-9a-f]{6,64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "size",
        "fingerprint",
        "kind"
      ],
      "title": "TaskApprovalMedia",
      "type": "object"
    },
    "TaskApprovalReview": {
      "additionalProperties": false,
      "properties": {
        "approval_mode": {
          "maxLength": 64,
          "title": "Approval Mode",
          "type": "string"
        },
        "card": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskApprovalCard"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expires_at": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "maxLength": 16384,
          "title": "Message",
          "type": "string"
        },
        "message_truncated": {
          "title": "Message Truncated",
          "type": "boolean"
        },
        "nonce": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nonce"
        },
        "person_only": {
          "default": false,
          "title": "Person Only",
          "type": "boolean"
        },
        "requested_at": {
          "maxLength": 80,
          "title": "Requested At",
          "type": "string"
        },
        "response_available": {
          "title": "Response Available",
          "type": "boolean"
        },
        "revision": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "run_id",
        "revision",
        "message",
        "requested_at",
        "expires_at",
        "approval_mode",
        "message_truncated",
        "response_available"
      ],
      "title": "TaskApprovalReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/TaskApprovalReview"
      },
      "maxItems": 100,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "revision": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total",
    "revision",
    "next_cursor"
  ],
  "title": "TaskApprovalPage",
  "type": "object"
}
