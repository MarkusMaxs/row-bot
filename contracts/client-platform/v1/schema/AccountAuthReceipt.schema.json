{
  "$defs": {
    "AccountAuthSnapshot": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "enum": [
            "google",
            "x",
            "microsoft"
          ],
          "title": "Account",
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "configured": {
          "title": "Configured",
          "type": "boolean"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sign_in": {
          "enum": [
            "this_computer",
            "link",
            "device",
            "unavailable"
          ],
          "title": "Sign In",
          "type": "string"
        },
        "sign_in_blocker": {
          "anyOf": [
            {
              "enum": [
                "public_address_required",
                "desktop_client",
                "redirect_not_listed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sign In Blocker"
        },
        "state": {
          "enum": [
            "not_configured",
            "not_authenticated",
            "saved_unchecked",
            "partial",
            "connected",
            "invalid",
            "expired",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "token_files": {
          "maximum": 17,
          "minimum": 0,
          "title": "Token Files",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "account",
        "revision",
        "configured",
        "state",
        "token_files",
        "sign_in"
      ],
      "title": "AccountAuthSnapshot",
      "type": "object"
    },
    "PlanDeviceCode": {
      "additionalProperties": false,
      "description": "A code to enter on the service's own page, on any device (RFC 8628).",
      "properties": {
        "user_code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "User Code",
          "type": "string"
        },
        "verification_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Verification Uri",
          "type": "string"
        },
        "verification_uri_complete": {
          "default": "",
          "maxLength": 2048,
          "title": "Verification Uri Complete",
          "type": "string"
        }
      },
      "required": [
        "user_code",
        "verification_uri"
      ],
      "title": "PlanDeviceCode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account": {
      "enum": [
        "google",
        "x",
        "microsoft"
      ],
      "title": "Account",
      "type": "string"
    },
    "action": {
      "enum": [
        "import_credentials",
        "check",
        "start",
        "disconnect"
      ],
      "title": "Action",
      "type": "string"
    },
    "authorization_url": {
      "anyOf": [
        {
          "maxLength": 8192,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization Url"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "device_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanDeviceCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expires_in": {
      "anyOf": [
        {
          "maximum": 3600,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires In"
    },
    "message": {
      "maxLength": 256,
      "title": "Message",
      "type": "string"
    },
    "phase": {
      "enum": [
        "running",
        "cancel_requested",
        "cancelled",
        "completed",
        "failed"
      ],
      "title": "Phase",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot": {
      "$ref": "#/$defs/AccountAuthSnapshot"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "account",
    "action",
    "phase",
    "message",
    "snapshot"
  ],
  "title": "AccountAuthReceipt",
  "type": "object"
}
