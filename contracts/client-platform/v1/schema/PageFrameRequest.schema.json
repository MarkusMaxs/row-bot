{
  "$defs": {
    "PageTheme": {
      "additionalProperties": false,
      "description": "Row-Bot's colours for both themes (token name to colour) and the one in use.",
      "properties": {
        "dark": {
          "additionalProperties": {
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Dark",
          "type": "object"
        },
        "light": {
          "additionalProperties": {
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Light",
          "type": "object"
        },
        "mode": {
          "enum": [
            "light",
            "dark"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "PageTheme",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "theme": {
      "$ref": "#/$defs/PageTheme"
    }
  },
  "required": [
    "theme"
  ],
  "title": "PageFrameRequest",
  "type": "object"
}
