{
  "$defs": {
    "ComputerUseProblem": {
      "additionalProperties": false,
      "description": "Why computer use couldn't start in this conversation, and how to fix it.",
      "properties": {
        "fix": {
          "maxLength": 240,
          "title": "Fix",
          "type": "string"
        },
        "message": {
          "maxLength": 240,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message",
        "fix"
      ],
      "title": "ComputerUseProblem",
      "type": "object"
    },
    "ComputerUseSnapshot": {
      "additionalProperties": false,
      "description": "The conversation's computer use step: the app, what Row-Bot is doing, Stop.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "app": {
          "maxLength": 120,
          "title": "App",
          "type": "string"
        },
        "can_stop": {
          "title": "Can Stop",
          "type": "boolean"
        },
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "doing": {
          "maxLength": 200,
          "title": "Doing",
          "type": "string"
        },
        "has_picture": {
          "title": "Has Picture",
          "type": "boolean"
        },
        "problem": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComputerUseProblem"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "enum": [
            "working",
            "paused",
            "waiting_approval",
            "stopped"
          ],
          "title": "State",
          "type": "string"
        },
        "window": {
          "maxLength": 200,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "conversation_id",
        "revision",
        "active",
        "state",
        "app",
        "window",
        "doing",
        "has_picture",
        "problem",
        "can_stop"
      ],
      "title": "ComputerUseSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "computer_use.stop",
      "title": "Action",
      "type": "string"
    },
    "code": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Code"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "computer_use": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComputerUseSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Conversation Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "action",
    "conversation_id",
    "status",
    "code",
    "computer_use"
  ],
  "title": "ComputerUseReceipt",
  "type": "object"
}
