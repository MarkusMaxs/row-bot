{
  "$defs": {
    "UpdateEngineView": {
      "additionalProperties": false,
      "description": "The background updater: preparing, ready, applying, or why it stopped.",
      "properties": {
        "apply_when": {
          "anyOf": [
            {
              "enum": [
                "now",
                "when_idle",
                "on_quit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Apply When"
        },
        "downloaded": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Downloaded",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "full_installer_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Full Installer Url"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Message"
        },
        "phase": {
          "enum": [
            "idle",
            "checking",
            "downloading",
            "staging",
            "ready",
            "applying",
            "verified",
            "failed"
          ],
          "title": "Phase",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "step": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step"
        },
        "total": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "phase",
        "version",
        "step",
        "message",
        "error",
        "retryable",
        "apply_when",
        "full_installer_url",
        "downloaded",
        "total"
      ],
      "title": "UpdateEngineView",
      "type": "object"
    },
    "UpdateHostRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "check",
            "update_now",
            "skip",
            "pause",
            "resume"
          ],
          "title": "Action",
          "type": "string"
        },
        "requested_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requested At"
        }
      },
      "required": [
        "action",
        "requested_at"
      ],
      "title": "UpdateHostRequest",
      "type": "object"
    },
    "UpdateHostView": {
      "additionalProperties": false,
      "description": "ROW_BOT_UPDATES=external: what the host that applies updates reports.",
      "properties": {
        "available_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Version"
        },
        "current_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Version"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Message"
        },
        "notes_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes Url"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/UpdateHostRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "unknown",
            "idle",
            "checking",
            "downloading",
            "ready",
            "applying",
            "failed",
            "paused"
          ],
          "title": "State",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Updated At"
        }
      },
      "required": [
        "state",
        "current_version",
        "available_version",
        "message",
        "notes_url",
        "updated_at",
        "request"
      ],
      "title": "UpdateHostView",
      "type": "object"
    },
    "UpdateRelease": {
      "additionalProperties": false,
      "properties": {
        "asset_size": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Asset Size",
          "type": "integer"
        },
        "channel": {
          "enum": [
            "stable",
            "beta"
          ],
          "title": "Channel",
          "type": "string"
        },
        "html_url": {
          "maxLength": 2048,
          "title": "Html Url",
          "type": "string"
        },
        "notes": {
          "maxLength": 16000,
          "title": "Notes",
          "type": "string"
        },
        "published_at": {
          "maxLength": 64,
          "title": "Published At",
          "type": "string"
        },
        "verified_manifest": {
          "title": "Verified Manifest",
          "type": "boolean"
        },
        "version": {
          "maxLength": 64,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "channel",
        "published_at",
        "notes",
        "html_url",
        "asset_size",
        "verified_manifest"
      ],
      "title": "UpdateRelease",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_work": {
      "items": {
        "maxLength": 120,
        "type": "string"
      },
      "maxItems": 8,
      "title": "Active Work",
      "type": "array"
    },
    "auto_check": {
      "title": "Auto Check",
      "type": "boolean"
    },
    "auto_download": {
      "title": "Auto Download",
      "type": "boolean"
    },
    "available": {
      "anyOf": [
        {
          "$ref": "#/$defs/UpdateRelease"
        },
        {
          "type": "null"
        }
      ]
    },
    "channel": {
      "enum": [
        "stable",
        "beta"
      ],
      "title": "Channel",
      "type": "string"
    },
    "current_version": {
      "maxLength": 64,
      "title": "Current Version",
      "type": "string"
    },
    "dev_install": {
      "title": "Dev Install",
      "type": "boolean"
    },
    "engine": {
      "$ref": "#/$defs/UpdateEngineView"
    },
    "host": {
      "anyOf": [
        {
          "$ref": "#/$defs/UpdateHostView"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_check": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Check"
    },
    "last_success": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Success"
    },
    "legacy_install": {
      "title": "Legacy Install",
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "self",
        "external",
        "unavailable"
      ],
      "title": "Mode",
      "type": "string"
    },
    "previous_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Version"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "skipped_versions": {
      "items": {
        "maxLength": 64,
        "type": "string"
      },
      "maxItems": 1,
      "title": "Skipped Versions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "revision",
    "channel",
    "current_version",
    "last_check",
    "last_success",
    "skipped_versions",
    "available",
    "dev_install",
    "mode",
    "auto_check",
    "auto_download",
    "engine",
    "previous_version",
    "legacy_install",
    "host",
    "active_work"
  ],
  "title": "UpdateSnapshot",
  "type": "object"
}
