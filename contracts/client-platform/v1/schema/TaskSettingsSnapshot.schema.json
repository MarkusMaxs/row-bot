{
  "$defs": {
    "TaskSettingsFields": {
      "additionalProperties": false,
      "properties": {
        "agent_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Profile Id",
          "type": "string"
        },
        "always_ask": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Always Ask",
          "type": "array"
        },
        "approval_mode": {
          "enum": [
            "block",
            "approve",
            "auto",
            "full"
          ],
          "title": "Approval Mode",
          "type": "string"
        },
        "missed_runs": {
          "default": "skip",
          "enum": [
            "skip",
            "run_once"
          ],
          "title": "Missed Runs",
          "type": "string"
        },
        "model_override": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Override"
        },
        "send_results": {
          "default": "every_run",
          "enum": [
            "every_run",
            "needs_me",
            "digest"
          ],
          "title": "Send Results",
          "type": "string"
        },
        "trigger_task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trigger Task Id"
        },
        "trigger_type": {
          "enum": [
            "none",
            "task_complete",
            "webhook"
          ],
          "title": "Trigger Type",
          "type": "string"
        },
        "workspace_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        }
      },
      "required": [
        "trigger_type",
        "trigger_task_id",
        "model_override",
        "agent_profile_id",
        "approval_mode"
      ],
      "title": "TaskSettingsFields",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conversation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Conversation Id"
    },
    "effective_approval_mode": {
      "anyOf": [
        {
          "enum": [
            "block",
            "approve",
            "auto",
            "full"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Effective Approval Mode"
    },
    "fields": {
      "$ref": "#/$defs/TaskSettingsFields"
    },
    "full_autonomy_confirmed": {
      "default": false,
      "title": "Full Autonomy Confirmed",
      "type": "boolean"
    },
    "profile_available": {
      "title": "Profile Available",
      "type": "boolean"
    },
    "profile_revision": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Profile Revision"
    },
    "revision": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Task Id",
      "type": "string"
    },
    "webhook_configured": {
      "title": "Webhook Configured",
      "type": "boolean"
    },
    "workspace_available": {
      "default": true,
      "title": "Workspace Available",
      "type": "boolean"
    },
    "workspace_name": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Name"
    }
  },
  "required": [
    "task_id",
    "revision",
    "fields",
    "profile_revision",
    "effective_approval_mode",
    "profile_available",
    "webhook_configured",
    "conversation_id"
  ],
  "title": "TaskSettingsSnapshot",
  "type": "object"
}
