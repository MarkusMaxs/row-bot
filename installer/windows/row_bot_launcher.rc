// Resources for Row-Bot.exe: the icon, the manifest and the version.
// build_installer.ps1 writes row_bot_launcher_version.h for each build.
#include <winver.h>
#include "row_bot_launcher_version.h"

1 ICON "row-bot.ico"
1 24 "row_bot_launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ROWBOT_VERSION_COMMA
 PRODUCTVERSION ROWBOT_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Row-Bot"
            VALUE "FileDescription", "Row-Bot"
            VALUE "FileVersion", ROWBOT_VERSION_STR
            VALUE "InternalName", "Row-Bot"
            VALUE "LegalCopyright", "Copyright 2026 Row-Bot Contributors. Apache License 2.0."
            VALUE "OriginalFilename", "Row-Bot.exe"
            VALUE "ProductName", "Row-Bot"
            VALUE "ProductVersion", ROWBOT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
